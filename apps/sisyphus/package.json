{
  "name": "sisyphus",
  "version": "0.1.0",
  "private": true,
  "description": "Sisyphus, a node of the Sisyphus network",
  "author": "Sisyphus Network (rvnminers-A-and-N, excho0)",
  "homepage": "https://github.com/sisyphus-network/Sisyphus",
  "license": "Apache-2.0",
  "packageManager": "npm@11",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node --experimental-strip-types dev/verify-locale-flags.mjs",
    "proto:generate": "protoc -I ../../proto --es_out=../../packages/client/src/gen --es_opt=target=ts,import_extension=.js ../../proto/sisyphus/node/v1/node.proto",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package:dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "test:package": "node dev/verify-package.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test dev/*.test.mjs",
    "test:daemon": "node --experimental-strip-types dev/daemon-lifecycle-smoke.mjs",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.0",
    "@sisyphus/client": "file:../../packages/client",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "flagpack-core": "2.1.0",
    "lucide-react": "^1.55.0",
    "input-otp": "^1.5.0",
    "motion": "14.1.0",
    "protobufjs": "8.8.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-globe.gl": "^2.38.0",
    "react-resizable-panels": "^4.14.4",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "world-countries-centroids": "^1.0.0"
  },
  "overrides": {
    "@grpc/proto-loader": {
      "protobufjs": "8.8.1"
    }
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
